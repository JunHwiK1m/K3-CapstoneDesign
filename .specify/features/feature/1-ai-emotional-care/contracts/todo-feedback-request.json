{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TodoFeedbackRequest",
  "type": "object",
  "properties": {
    "total_count": { "type": "integer", "minimum": 0 },
    "completed_count": { "type": "integer", "minimum": 0 },
    "completion_rate": { "type": "number", "minimum": 0, "maximum": 1 },
    "persona_style": { "type": "string", "enum": ["BASIC", "FRIENDLY", "STRICT"] },
    "recent_emotion": { "type": "string", "enum": ["JOY", "SADNESS", "STRESS", "NEUTRAL"] }
  },
  "required": ["total_count", "completed_count", "completion_rate", "persona_style", "recent_emotion"]
}
