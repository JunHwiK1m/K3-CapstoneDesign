{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "JournalAnalysisRequest",
  "type": "object",
  "properties": {
    "journal_id": { "type": "integer" },
    "content": { "type": "string", "maxLength": 5000 },
    "voice_url": { "type": ["string", "null"] },
    "persona_style": { "type": "string", "enum": ["BASIC", "FRIENDLY", "STRICT"] }
  },
  "required": ["journal_id", "content", "persona_style"]
}
